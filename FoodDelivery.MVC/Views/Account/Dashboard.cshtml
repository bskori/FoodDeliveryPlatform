@{
    ViewData["Title"] = "Customer Dashboard";
}

<div class="container mt-5">

    <h2>Welcome to Food Delivery!</h2>

    <h5 class="mt-5">Customer Information</h5>

    <table class="table table-bordered mt-3">
        <tbody>
            <tr>
                <th>User ID</th>
                <td>@ViewBag.UserId</td>
            </tr>
            <tr>
                <th>Full Name</th>
                <td>@ViewBag.FullName</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>@ViewBag.Email</td>
            </tr>
            <tr>
                <th>Role</th>
                <td>@ViewBag.Role</td>
            </tr>
        </tbody>
    </table>

    <p class="text-success">
    You are logged in successfully.
    </p>

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Browse Food</a>

    <form asp-controller="Account" asp-action="Logout" class="mt-3" method="post">

        @Html.AntiForgeryToken()

        <button type="submit" class="btn btn-danger">Logout</button>

    </form>

</div>